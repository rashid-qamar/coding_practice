(function(){function loadStyle(url,onload=()=>{}){const link=document.createElement("link");link.rel="stylesheet";link.href=url;link.onload=onload;document.head.appendChild(link)}loadStyle("https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css");require.config({packages:[{name:"katex",location:"https://cdn.jsdelivr.net/npm/katex@0.15.2",main:"dist/katex.min"}],waitSeconds:20});require(["katex/dist/contrib/auto-render.min"],function(renderMathInElement){class GfgTex extends HTMLElement{connectedCallback(){this.textContent="[Tex]"+this.textContent+"[/Tex]";renderMathInElement(this,{delimiters:[{left:"[Tex]",right:"[/Tex]",display:false}],ignoredTags:["script","noscript","style","textarea","code","option"]});this.style.display="inline-flex";this.style.maxWidth="100%";this.style.overflowX="auto"}}customElements.define("gfg-tex",GfgTex);window.renderGfgTex=node=>{renderMathInElement(node,{delimiters:[{left:"[Tex]",right:"[/Tex]",display:false}],ignoredTags:["script","noscript","style","textarea","code","option"]})}})})();